{
  "name": "@radebe/scripts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "clean": "Remove-Item -Recurse -Force dist, tsconfig.tsbuildinfo -ErrorAction SilentlyContinue",
    "doctor": "node ./dist/src/doctor.js",
    "sea:build": "node ./dist/src/sea.js build",
    "sea:bundle": "node ./dist/src/sea.js bundle",
    "sea:smoke": "node ./dist/src/sea.js smoke",
    "test": "node --test dist/test",
    "unity:deploy": "node ./dist/src/unity-deploy.js",
    "unity:package": "node ./dist/src/unity-package-native-poc.js",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "postject": "^1.0.0-alpha.6"
  }
}

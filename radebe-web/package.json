{
  "name": "@radebe/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run generate:example-previews && tsc -b && vite build",
    "clean": "Remove-Item -Recurse -Force dist, tsconfig.tsbuildinfo, public/generated -ErrorAction SilentlyContinue",
    "dev": "npm run generate:example-previews && vite",
    "generate:example-previews": "npm run build -w @radebe/core && node scripts/generate-example-previews.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@radebe/core": "0.1.0",
    "codemirror": "^6.0.2",
    "preact": "^10.29.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "vite": "^5.4.19"
  }
}

{
  "name": "radebe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "20.18.1",
    "npm": "10.9.2"
  },
  "workspaces": [
    "radebe-core",
    "radebe-cli",
    "radebe-web",
    "radebe-vscode",
    "scripts"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:release:web": "npm run build -w @radebe/web",
    "build:vscode": "node ./node_modules/typescript/bin/tsc -b radebe-core radebe-vscode",
    "clean": "npm run clean --workspaces --if-present",
    "dev:web": "npm run dev -w @radebe/web",
    "diagnose:web:pages": "npm run build -w @radebe/web && npm run build -w @radebe/scripts && node scripts/dist/src/web-page-perf.js",
    "deploy:unity": "npm run package:cli:sea && npm run unity:deploy -w @radebe/scripts",
    "package:unity": "node ./node_modules/typescript/bin/tsc -b scripts && node scripts/dist/src/sea.js build && node scripts/dist/src/unity-package-native-poc.js",
    "package:cli:sea": "node ./node_modules/typescript/bin/tsc -b scripts && node scripts/dist/src/sea.js build",
    "package:vscode": "node ./node_modules/typescript/bin/tsc -b radebe-core radebe-vscode && node scripts/install-vscode-extension.mjs",
    "install:vscode": "npm run build:vscode && node scripts/install-vscode-extension.mjs --install",
    "smoke:cli:sea": "node ./node_modules/typescript/bin/tsc -b scripts && node scripts/dist/src/sea.js smoke",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.8.3"
  }
}
